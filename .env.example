# Copy to .env next to docker-compose.yml; Docker Compose reads it automatically.

# Required
CRAWLER_API_TOKEN=
CRAWLER_R2_ENDPOINT_URL=
CRAWLER_R2_BUCKET=
CRAWLER_R2_ACCESS_KEY_ID=
CRAWLER_R2_SECRET_ACCESS_KEY=

# Optional; the values shown are the defaults
# CRAWL_SEED_URLS=https://example.com
# CRAWL_CYCLE_PAGES=500
# CRAWL_RECRAWL_TTL=86400
# CRAWL_CONCURRENCY=5
# CRAWL_DELAY=1.0
# CRAWLER_ADMISSION_TARGET_PENDING=500000
